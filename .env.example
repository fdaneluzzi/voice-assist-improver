# Home Assistant
VAI_HA_URL=http://homeassistant.local:8123
# Long-lived token of a NON-admin Home Assistant user, used by the voice path (Assist tools over MCP).
VAI_HA_MCP_TOKEN=
# Admin token: only for the scheduled analysis and "do it for me" (milestones M3 and M5). Never used by voice.
VAI_HA_TOKEN=

# Network: networks allowed to call the Ollama-compatible endpoint (default: loopback only)
VAI_HOST=127.0.0.1
VAI_PORT=11435
VAI_ALLOWED_NETWORKS=127.0.0.0/8,::1/128

# Backend: "echo" (development only) or "anthropic"
VAI_BACKEND=echo
# Model names offered to Home Assistant. A name starting with "claude-" selects that model.
VAI_MODELS=default

# Anthropic API (create the key in the Anthropic Console and set a LOW spend limit there)
VAI_ANTHROPIC_API_KEY=
# Only if the API asks for it ("not scoped to a workspace"): prefer a key created inside a workspace.
VAI_ANTHROPIC_WORKSPACE_ID=
VAI_MODEL=claude-sonnet-5-5
VAI_ANALYSIS_MODEL=claude-sonnet-5-5
# low | medium | high. Lower is faster, which matters for voice.
VAI_EFFORT=low
# Off by default: mixing web content with home control is a prompt-injection risk.
VAI_WEB_SEARCH=false
# Stop calling the AI service when this month's estimated spend reaches the cap (0 = no cap).
VAI_MONTHLY_BUDGET_USD=0
# Voice tools that must never reach the model (fnmatch patterns, comma separated).
VAI_VOICE_TOOL_DENYLIST=

# Language: en (default) or pt-BR. An optional custom prompt file overrides the built-in voice prompt.
VAI_LANGUAGE=en
VAI_CUSTOM_VOICE_PROMPT_FILE=

# Storage
VAI_DATA_DIR=data
VAI_RETENTION_DAYS=90
VAI_TIMEZONE=UTC
