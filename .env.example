# Home Assistant
VAI_HA_URL=http://homeassistant.local:8123
VAI_HA_TOKEN=

# Network: networks allowed to call the Ollama-compatible endpoint (default: loopback only)
VAI_HOST=127.0.0.1
VAI_PORT=11435
VAI_ALLOWED_NETWORKS=127.0.0.0/8,::1/128

# Backend (echo = development only; "anthropic" arrives in milestone M1)
VAI_BACKEND=echo
VAI_MODELS=default

# Language: en (default) or pt-BR. An optional custom prompt file overrides the built-in voice prompt.
VAI_LANGUAGE=en
VAI_CUSTOM_VOICE_PROMPT_FILE=

# Storage
VAI_DATA_DIR=data
VAI_RETENTION_DAYS=90
VAI_TIMEZONE=UTC
